# Settings are environment variables (the app does not read this file): e.g. PORT=4000 npm start
PORT=3000
# Both books are always read in their Ontario versions (FanDuel region ON, DraftKings site CA-ON-SB);
# FD_REGION / DK_SITE are not settings any more: another value is ignored with a log line.
# Leagues: NFL is always on; college football (ncaaf) and the CFL come from the same two books
LEAGUES=nfl,ncaaf,cfl
# FanDuel push (AppSync price subscription, as on FanDuel's own site). 0 = polling only.
FD_PUSH=1
# FanDuel polling beat in ms: the safety net under the push (FanDuel's own widgets poll every ~5000 ms).
# Backs off on 429/403/5xx. Markets per request (FanDuel answers at most 80 per request):
FD_POLL_MS=1000
FD_CHUNK=50
# DraftKings snapshot client: auto = Node first, browser-compatible (curl_cffi, see requirements.txt) after a 403;
# native = Node only; browser = always the browser-compatible client.
DK_HTTP=auto
# how often to re-download the full snapshot (a reconciliation check; the socket carries every change)
DK_RESNAPSHOT_MS=30000
FD_RESNAPSHOT_MS=60000
# 0 = send to browsers the moment an upstream message is applied (default); >0 = fixed coalescing window in ms
SSE_BATCH_MS=0
# Redis (optional; without it everything runs in memory): DraftKings board checkpoint + frame log + price history survive restarts
# REDIS_URL=redis://...
# Edge (optional fallback machine): shared secret for /ingest/ws
# INGEST_TOKEN=...
