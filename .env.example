PORT=3000
# FanDuel polling interval in ms (the FD site itself polls every ~5000 ms; we use 2000 and back off on 429/403)
FD_POLL_MS=2000
FD_REGION=NJ
# DraftKings site/region. Ontario values were used during development; US alternatives: DK_SITE=US-NJ-SB DK_SITENAME=dkusnj
DK_SITE=CA-ON-SB
DK_SITENAME=dkcaon
DK_WS_HOST=sportsbook-ws-ca-on.draftkings.com
# how often to re-download the full snapshot (safety net for missed deltas / new lines)
DK_RESNAPSHOT_MS=60000
FD_RESNAPSHOT_MS=60000
# coalescing window for pushes to browsers
SSE_BATCH_MS=40
